{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "essential-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/closet.json",
          "/items/*.json",
          "/lang/*.lang",
          "/sound/music/A_Jazz_Piano.ogg",
          "/sound/sfx/hit.ogg",
          "/img/cheems/normal.png",
          "/**/*.(svg|cur|woff|woff2|ttf|otf)"
        ]
      }
    },
    {
      "name": "lazy-assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/**/*.(jpg|jpeg|png|apng|webp|avif|gif|txt|xml|csv|ico|ogg|mp3|wav|m4a)",
          "/sound/**/*",
          "/img/**/*",
          "/games/**/*"
        ]
      }
    }
  ]
}
